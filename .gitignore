# Runtime data: the database, the secret store and any local state.
# These are NEVER committed. The secret store file is additionally
# written with mode 0600 by the server.
data/
*.db
*.db-wal
*.db-shm
secrets.json
secrets.key
node_modules/
# Local personal-data helper scripts (kept in the user's PC folder, never
# in the repo): they embed personal CV/salary data and must not be
# committed, especially while the repository is public.
create-person-from-cv.mjs
declare-screening-facts.mjs
fill-eu-authorisations.mjs
update-person-fields.mjs
